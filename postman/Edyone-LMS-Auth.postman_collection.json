            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"topic\": \"Class Schedule\",\n  \"description\": \"Request to update my class timing.\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/v1/teacher/admin/contact",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "teacher", "admin", "contact"]
            },
            "description": "Teacher raises a query/contact request to the school admin."
          }
        },
        {
          "name": "Teacher → My Contact List",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/teacher/admin/contact-list",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "teacher", "admin", "contact-list"]
            },
            "description": "Returns the teacher's own contact requests with admin replies."
          }
        },
        {
          "name": "Teacher → Reply to Admin",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"contact_id\": 1,\n  \"reply\": \"Thanks for the clarification.\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/v1/teacher/admin/contact-reply",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "teacher", "admin", "contact-reply"]
            },
            "description": "Teacher adds a follow-up reply to an existing contact thread."
          }
        }
      ]
    },
